# Fill these in. The setup script copies this file to .env.supabase for you.
# .env.supabase is git-ignored and never leaves your computer.
# Put values with spaces or < > in double quotes, like RESEND_FROM below.

# Supabase dashboard > Project Settings > General > "Reference ID" (20 lowercase letters)
SUPABASE_PROJECT_REF=
# The database password you chose when you created the project
SUPABASE_DB_PASSWORD=

# OPTIONAL. Leave these three empty for a lean launch: you approve each payment by hand in /admin.
# Add them later and run  npm run setup:supabase  again to switch on automatic checking and emails.
# console.anthropic.com > API keys. Used to read payment receipts.
ANTHROPIC_API_KEY=
# resend.com > API Keys
RESEND_API_KEY=
# Must use a domain you verified in Resend
RESEND_FROM=

# Your live site address, no slash at the end
SITE_URL=https://directcollabs.online
# Digits only, country code first, for example 923001234567
WHATSAPP_NUMBER=

# Optional. Leave empty for now and add later.
PIXEL_ID=
META_CAPI_TOKEN=
COURSE_VIDEO_URL=
# Your Thinkific (or other) course link. When set, the course page shows an "Open the course" button to it.
COURSE_INVITE_URL=

# Leave empty. The script creates a random one and saves it here.
VERIFY_FUNCTION_SECRET=
